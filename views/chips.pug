extends layout
block content
  h1= title
  div.container-fluid
    div.row.m-1
      div.col-sm-12.mb-3
        button.btn.btn-success(onclick='dispatch("/chips/create")') Create
      each item in results
        div.col-sm-12.m-1
          | Item #{item.chipsBrand} (#{item.chipsFlavor}) is #{item.cost}
          button.btn.btn-info.ms-2(onclick=`dispatch("/chips/detail?id=${item._id}")`) Details
          button.btn.btn-primary.ms-2(onclick=`dispatch("/chips/update?id=${item._id}")`) Update
          button.btn.btn-danger.ms-2(onclick=`dispatch("/chips/delete?id=${item._id}")`) Delete
  script.
    function dispatch(path){
      window.location.href = path
    }