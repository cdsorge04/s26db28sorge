extends layout
block content
  h1= title
  - let items = results
  div.container-fluid
    div.row.m-1
      each item in items
        - let destination = `dispatch("/chips/update?id=${item._id}")`
        div.row-sm-2.m-1
          | Item #{item.chip_type}(#{item.size}) is #{item.cost}
          button.btn.btn-primary.ml-1(onclick=destination) Update
  script.
    function dispatch(path){
      window.location.href = path
    }