extends layout
block content
  h1= title
  - let items = results;
  div.container-fluid
    div.row
      each item in items
        div.row-sm-2.m-1
          span Item #{item.chipsBrand}(#{item.chipsFlavor}) 
            is #{item.cost}
          a.btn.btn-primary(href=`/costumes/update?id=${item._id}`) Update
script.
  function dispatch(path){
    window.location.href = path
  }